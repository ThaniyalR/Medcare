# Copy this file to .env. Never put real secrets in source control.
APP_ENV=development
PORT=8000
ALLOW_LOCAL_OTP=true
SKIP_PHONE_VERIFICATION=false

# For real SMS, configure a Twilio Verify service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Razorpay TEST keys can be used for development; use LIVE keys only after launch review.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set a long random value. Protect this key as an administrator credential.
ADMIN_REVIEW_KEY=

# Optional database location. The default is data/nutrix.sqlite3.
# NUTRIX_DB=
